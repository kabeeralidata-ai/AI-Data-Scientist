# ==============================
# Backend
# ==============================
# Use "postgres" as the host when running via docker-compose (overridden automatically
# there); use "localhost" when running the backend locally against `docker compose up postgres`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_datascientist
SECRET_KEY=change_this_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# File storage
UPLOAD_DIR=./storage/uploads
MODEL_DIR=./storage/models
REPORT_DIR=./storage/reports
MAX_UPLOAD_SIZE_MB=100

# AI — provider selection. "ollama" (default) uses only Ollama/Qwen. "gemini" tries
# Gemini first and falls back to Ollama automatically if Gemini is unreachable/fails.
AI_PROVIDER=ollama

# Ollama + Qwen (always available as a fallback, even when AI_PROVIDER=gemini)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60

# Gemini (Google AI Studio) — only used when AI_PROVIDER=gemini. Get a free key at
# https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=120

# ==============================
# Frontend
# ==============================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================
# Postgres (docker-compose)
# ==============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_datascientist
